{
  "name": "@pi-vault/pi-status",
  "version": "0.3.0",
  "type": "module",
  "description": "Pi extension that replaces the default status with a Codex-like status",
  "author": "Lanh Hoang <lanhhoang@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/pi-vault/pi-status#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-vault/pi-status.git"
  },
  "bugs": {
    "url": "https://github.com/pi-vault/pi-status/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-status"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry-run": "pnpm pack --dry-run",
    "pack:verify": "node scripts/verify-pack.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm pack:verify"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "src",
    "docs/assets",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "dependencies": {
    "@pi-vault/pi-usage": "^0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
